import java.util.*;

class Node {
    int data;
    Node next;
    Node (int val) {
      this.data = val;
      this.next = null;
    }
}
public class Main {
    public static void main(String[] args) {
      Node p = new Node(1);
      p.next = new Node(2);
      p.next.next = new Node(3);
      p.next.next.next = new Node(4);
      p.next.next.next.next = new Node(5);
      Node temp = p;
      while (temp.next != null) {
        System.out.print(temp.data + " -> ");
        temp = temp.next;
      }
      System.out.print(temp.data + " -> null");
    }
}
